extends RefCounted
## GENERATED by /tmp/extract_codex.py from the crawler's
## godot-full-game/scripts/data.gd (const CODEX + CODEX_SUBTITLE,
## classified by that file's own CREATIONS / COALESCE_REGISTRY /
## boss-reference datasets). Do not hand-edit; re-run the extractor.

const SUBTITLE := "What the crew has learned, written plain. Existence is bigger than Karath — this is the part of it you've seen."

const CATEGORIES := [
	{"name": "LORE & FOUNDATIONS", "entries": [
		{"id": "ember", "title": "Ember Rest", "body": "Delvers measure Karath in universes. Ember Rest is one room with a fire in all that dark — a lone lit waypoint, and the whole of the world a delve crew walks home to. Stand at the north edge on a clear night and the rest of the existence is still out there: dead towers on the horizon, and things above them too big to have ever been alive.", "plate": ""},
		{"id": "delving", "title": "Delving", "body": "When the makers vanished, they left their makings behind — places still running on old instructions, full of things worth having. A delve crew walks in, takes what the place can spare, and walks out. That last part is the whole job.", "plate": ""},
		{"id": "strength", "title": "Strength, the Red", "body": "Strength is the power that rules Karath. It is red. It is in the roads, the walls, the beasts, the blood-price of every old law. Strength founded everything on Karath — down here, nothing else has ever come.", "plate": ""},
		{"id": "makings", "title": "Makings", "body": "A making is a thing an architect built that outlived its builder: a vault, a garden, a whole small world. A making does not know its maker is gone. It keeps doing the last things it was told to do. Forever, if nothing stops it.", "plate": ""},
		{"id": "ways", "title": "Ways of Making", "body": "No two makers made things the same way. Each had a way — a method that was also a law: everything they built had to fit inside it. Delvers learn to read a making's way the way you'd read a lock. It tells you what the place can do. And what it can't.", "plate": ""},
		{"id": "forms", "title": "Closed Forms", "body": "Some makings guard themselves with closed forms: finished shapes, sealed and final. A closed form does not argue. It simply is — until something breaks it, and breaking one takes a Breaker's kind of violence, aimed at the seam.", "plate": ""},
		{"id": "husk", "title": "Formed Husks", "body": "Guards a maker shaped out of a closed form and a single order: keep them out. The maker is gone. The order is not. A husk will execute it on the ten-thousandth stranger exactly as it did on the first.", "plate": ""},
		{"id": "threshold", "title": "The Ring in the Wilds", "body": "East of Ember Rest stands a ring of old metal, taller than a house, sunk in the ash. The oldest delvers call it a Threshold — a doorway the makers used to step between worlds. It has been dark longer than anyone's grandfather's grandfather. Doorways, the saying goes, do not stop being doorways just because nobody opens them.", "plate": ""},
		{"id": "tiers", "title": "The Tiers of Work", "body": "Delvers grade everything they pull out of a making. Common work, Rare, Epic, Mythic — each rarer, each stronger. Above those, Omnipotent: work so great that lesser powers mistake it for a maker's own hand. And at the very top, Architect: made by a maker directly, tied to their way — and every piece of it charges a cost when used. Always. That is the rule.", "plate": ""},
		{"id": "anomalies", "title": "Anomalies", "body": "Delvers whisper about this one, and nobody writes it down. When a foreign coalescence rests in a dead place, the place starts changing — new shapes in rooms that were empty, new guards on paths that were walked, doors where no doors were cut. The ones who saw it describe it differently every time. The only part that repeats: it was not like that before you came back.", "plate": ""},
		{"id": "salt", "title": "The Salt Flats", "body": "White ground that crunches underfoot, stretching farther than the eye wants to follow. Delvers cross it because the old road runs through it, and because things left out here stay left — salt keeps what it covers. The crew's boots came back white. The rest of the story is in the packs they carried out.", "plate": ""},
		{"id": "foundry", "title": "The Sunken Foundry", "body": "A making that made things, sunk to its waist in black water that never drains. The furnaces are cold. The moulds are still stacked, row on row, waiting for hands that never came back. Delvers take the moulds. They leave the water alone. Nobody says why, and nobody tests it.", "plate": ""},
		{"id": "quarry", "title": "The Old Quarry", "body": "A cut in the ground where stone was taken for walls that are now ash. The cutters left their picks in the rock, mid-swing, like the work stopped between one breath and the next. Delvers still cut here — the stone is good, and the old picks are better.", "plate": ""},
		{"id": "cartography", "title": "The Cartographer's Map", "body": "Perrin draws Karath the only honest way: by walking it. Every line on his map is a road somebody's boots actually took. The blank parts are not empty. They are unwalked. That is a different thing, and the map says so by leaving them blank.", "plate": ""},
		{"id": "cleared", "title": "Cleared Ground", "body": "A place that has been cleared stays cleared where it matters. The keeper does not come back — the last law failed, and a failed law does not stand up again. The small stock may shuffle back in with the next visit, and a changed place may still show its change, but the keeper's room stays empty. That is the difference between cleared and merely walked through: one you walk back into, the other you walk back through.", "plate": ""},
	]},
	{"name": "CREATIONS", "entries": [
		{"id": "thalor", "title": "Thalor Rest", "body": "A town that keeps its doors open after dark, because the dark out here is older than the town and locking a door never stopped it. The roofs are low, the wells are deep, and the people mend their own gear twice before they ask anyone else. Delvers rest here on the way down, and come back up quieter than they went.", "plate": "res://assets/codex_plates/thalor.jpg"},
		{"id": "mirell", "title": "Mirell Crossing", "body": "A crossing, not a town, though people live here anyway — where two old roads meet and neither goes anywhere anyone admits to. The stalls sell rope, lamp oil, and silence in that order. Crews pass through, trade, and do not linger. Lingering is how crossings keep you.", "plate": "res://assets/codex_plates/mirell.jpg"},
		{"id": "ossara", "title": "Ossara Gate", "body": "A gate with no wall attached, standing in open ground like a sentence with the rest torn off. People built their houses in its shadow anyway. The gate has never opened in living memory. Nobody has tried to force it, and the town keeps it that way on purpose.", "plate": "res://assets/codex_plates/ossara.jpg"},
		{"id": "nerith", "title": "Nerith Span", "body": "A span, not a town, though people live at both ends of it — a bridge over a drop nobody has measured, with houses tucked against the stone at either side. Crews cross it going down, and cross back quieter. The drop does not get mentioned twice.", "plate": "res://assets/codex_plates/nerith.jpg"},
		{"id": "voss", "title": "Voss Hollow", "body": "A hollow in the ground where the glass grows — not made, not mined, just there, in panes and shards, catching what little light reaches down. People live in the hollow because the glass keeps the wind out. Crews take nothing from the panes. The panes are spoken for.", "plate": "res://assets/codex_plates/voss.jpg"},
		{"id": "keld", "title": "Keld Rise", "body": "A rise with a watch on it, over ground that does not echo right. People built high because the deep below is quiet in a way that makes sleep hard. Crews pass through, trade, and keep their voices down. The deep hears everything, or so the watch claims.", "plate": "res://assets/codex_plates/keld.jpg"},
		{"id": "durn", "title": "Durn Watch", "body": "A watch over black water, where the steps go down and do not come back up the same. People built high and keep the lamps lit, because the water below is dark in a way that swallows light. Crews go down counted, and come back counted, and the counts never match. Nobody says why twice.", "plate": "res://assets/codex_plates/durn.jpg"},
		{"id": "sarn", "title": "Sarn Shore", "body": "A shore town where the gallery runs long behind the houses, full of things hung on walls by hands that are gone. People live in front of it and do not go behind it without a reason. The gallery keeps itself hung. That is the town's whole arrangement with it, and it holds.", "plate": "res://assets/codex_plates/sarn.jpg"},
		{"id": "brask", "title": "Brask Field", "body": "A field town at the edge of an orchard that should not grow. The trees are iron, the fruit is iron, and the harvest is iron — cut, carried, and hammered into tools that outlast their makers. People farm the orchard the way you farm weather: carefully, and never assuming it will hold.", "plate": "res://assets/codex_plates/brask.jpg"},
		{"id": "riven", "title": "Riven Market", "body": "A market town built where three dead roads meet, still trading after everything else around it stopped. Stalls stand where stalls always stood, and the toll is paid at the gate without argument — the market keeps its own accounts, and the accounts always balance, even when the traders don't.", "plate": "res://assets/codex_plates/riven.jpg"},
		{"id": "quill", "title": "Quill Reach", "body": "A reach town at the edge of a stack of rooms full of writing nobody living wrote. The stacks keep themselves shelved, and the town keeps its distance — close enough to read by, far enough to leave the writing alone.", "plate": "res://assets/codex_plates/quill.jpg"},
		{"id": "umbra", "title": "Umbra Fall", "body": "A fall town under a shadow that does not move with the sun. People walk the lit paths and do not step off them — off the paths, the shadow falls twice, and only the first shadow belongs to the walker.", "plate": "res://assets/codex_plates/umbra.jpg"},
		{"id": "ferren", "title": "Ferren Edge", "body": "An edge town where the grindstones never stop turning, though no hand turns them now. People live by the whet halls and keep their blades honest — a dull blade here is a debt, and debts at the edge get collected. Crews pass through, sharpen up, and do not linger past the last turning.", "plate": "res://assets/codex_plates/ferren.jpg"},
		{"id": "aeran", "title": "Aeran Gale", "body": "A gale town built where the wind never quite stops, even indoors. People walk leaned into it and sleep with the shutters latched, because the stair below breathes with the same wind. Crews go down light, and come back lighter — the gale takes what it is owed in weight, and nothing else.", "plate": "res://assets/codex_plates/aeran.jpg"},
		{"id": "tabor", "title": "Tabor Beat", "body": "A beat town where a drum sounds under the floors at all hours, though no drummer sits there. People live by the beat — work, rest, and walking all fall into it sooner or later. Crews that fight the rhythm tire fast. Crews that keep it walk the deep like they were born to it.", "plate": "res://assets/codex_plates/tabor.jpg"},
		{"id": "cindrel", "title": "Cindrel Kiln", "body": "A kiln town where the pits never go cold, though no hand feeds them now. People live by the firing pits and keep their pots honest — a cracked pot here is a debt, and the pits collect their debts in heat. Crews pass through, fire up, and do not linger past the last firing.", "plate": "res://assets/codex_plates/cindrel.jpg"},
		{"id": "veyne", "title": "Veyne Loom", "body": "A loom town where the rooms keep their own weave, though no hand works them now. People live by the warp rooms and keep their thread true — a tangled thread here is a debt, and the rooms collect it in knots. Crews pass through, mend up, and do not linger past the last shuttle.", "plate": "res://assets/codex_plates/veyne.jpg"},
		{"id": "halveth", "title": "Halveth Harbor", "body": "A harbor town where the yards keep their own knots, though no hand ties them now. People live by the knotted yards and keep their lines fast — a slipped knot here is a debt, and the yards collect it in rope. Crews pass through, tie up, and do not linger past the last tide.", "plate": "res://assets/codex_plates/halveth.jpg"},
		{"id": "merren", "title": "Merren Mill", "body": "A mill town where the stones never stop turning, though no hand feeds them now. People live by the grinding halls and keep their flour honest — a short measure here is a debt, and the mill collects its debts in grain. Crews pass through, grind up, and do not linger past the last turning.", "plate": "res://assets/codex_plates/merren.jpg"},
		{"id": "vallen", "title": "Vallen Wall", "body": "A wall town built against a wall that never leans, though nothing holds it up that any eye can see. People live in the wall's shadow and keep their gates true — a loose stone here is a debt, and the wall collects it in silence. Crews pass through, rest up, and do not linger past the last watch.", "plate": "res://assets/codex_plates/vallen.jpg"},
		{"id": "wellen", "title": "Wellen Well", "body": "A well town where the well never runs dry, though no rain falls here that anyone remembers. People live by the deep well and keep their buckets mended — a dry bucket here is a debt, and the well collects it in thirst. Crews pass through, drink up, and do not linger past the last drawing.", "plate": ""},
		{"id": "law_merren", "title": "Merren's Mill Law", "body": "What is ground in the mill stays ground; no meal there ever coarsens again, no stone there ever dulls. The mill keeps its own grinding, and the grinding keeps the mill.", "plate": ""},
		{"id": "law_vallen", "title": "Vallen's Wall Law", "body": "What is laid in the wall stays laid; no stone there ever slips, no wall there ever leans. The wall keeps its own standing, and the standing keeps the wall.", "plate": ""},
		{"id": "law_wellen", "title": "Wellen's Well Law", "body": "What is drawn from the well stays drawn; no bucket there ever comes up empty, no water there ever runs short. The well keeps its own depth, and the depth keeps the well.", "plate": ""},
		{"id": "malten", "title": "Malten Brewhouse", "body": "A brew town where the tuns never stop working, though no hand stirs them now. People live by the mash tuns and keep their measures honest — a short pour here is a debt, and the house collects its debts in kind. Crews pass through, drink up, and do not linger past the last tapping.", "plate": ""},
		{"id": "lode", "title": "Lode Mine", "body": "A mine town where the cuttings never stop giving, though no hand works them now. People live by the deep cuttings and keep their tallies honest — a short load here is a debt, and the mine collects its debts in ore. Crews pass through, load up, and do not linger past the last shift.", "plate": ""},
		{"id": "yarrow", "title": "Yarrow Croft", "body": "A croft town where the garden never stops growing, though no hand tends it now. People live by the walled garden and keep their cuttings honest — a short bunch here is a debt, and the garden collects its debts in kind. Crews pass through, gather up, and do not linger past the last cutting.", "plate": ""},
		{"id": "law_malten", "title": "Malten's Brew Law", "body": "What is brewed in the tuns stays brewed; no mash there ever sours, no cask there ever runs dry. The house keeps its own brewing, and the brewing keeps the house.", "plate": ""},
		{"id": "law_lode", "title": "Lode's Mine Law", "body": "What is cut in the mine stays cut; no vein there ever plays out, no roof there ever falls. The mine keeps its own cutting, and the cutting keeps the mine.", "plate": ""},
		{"id": "law_yarrow", "title": "Yarrow's Garden Law", "body": "What is grown in the garden stays grown; no sprig there ever wilts, no bed there ever lies fallow. The garden keeps its own growing, and the growing keeps the garden.", "plate": ""},
		{"id": "kessock", "title": "Kessock Charts", "body": "A chart town where the map rooms never stop being drawn, though no hand holds the pen now. People live by the charts and keep their roads honest — a wrong road here is a debt, and the house collects its debts in kind. Crews pass through, chart up, and do not linger past the last sounding.", "plate": ""},
		{"id": "stow", "title": "Stow Holt", "body": "A holt town where the propped halls never stop standing, though no hand shores them now. People live by the props and keep their timbers honest — a slack prop here is a debt, and the holt collects its debts in kind. Crews pass through, shore up, and do not linger past the last propping.", "plate": ""},
		{"id": "calmwater", "title": "Calmwater Reach", "body": "A reach town where the silent rooms never stop holding quiet, though no hand keeps them now. People live by the still rooms and keep their silences honest — a loud step here is a debt, and the reach collects its debts in kind. Crews pass through, quiet down, and do not linger past the last hush.", "plate": ""},
		{"id": "harrow", "title": "Harrow Loft", "body": "A loft town where the fletching benches never stop being worked, though no hand fits the flights now. People live by the arrows and keep their flights honest — a crooked flight here is a debt, and the loft collects its debts in kind. Crews pass through, fletch up, and do not linger past the last stringing.", "plate": ""},
		{"id": "vigil", "title": "Vigil Beacon", "body": "A beacon town where the lamp rooms never stop burning, though no hand trims the wicks now. People live by the lamps and keep their flames honest — a dim flame here is a debt, and the beacon collects its debts in kind. Crews pass through, light up, and do not linger past the last trimming.", "plate": ""},
		{"id": "fallow", "title": "Fallow Chase", "body": "A chase town where the hunting grounds never stop being walked, though no hand sets the snares now. People live by the snares and keep their sets honest — a sprung snare here is a debt, and the chase collects its debts in kind. Crews pass through, set out, and do not linger past the last setting.", "plate": ""},
		{"id": "madder", "title": "Madder Ford", "body": "A ford town where the dye vats never stop being stirred, though no hand holds the paddle now. People live by the vats and keep their colours honest — a running dye here is a debt, and the ford collects its debts in kind. Crews pass through, dye up, and do not linger past the last rinsing.", "plate": ""},
		{"id": "barley", "title": "Barley Mow", "body": "A mow town where the threshing floors never stop being worked, though no hand swings the flail now. People live by the floors and keep their sheaves honest — a thinned sheaf here is a debt, and the mow collects its debts in kind. Crews pass through, thresh up, and do not linger past the last winnowing.", "plate": ""},
		{"id": "tanbark", "title": "Tanbark Row", "body": "A row town where the tanning pits never stop being turned, though no hand works the hides now. People live by the pits and keep their leather honest — a cracked hide here is a debt, and the row collects its debts in kind. Crews pass through, tan up, and do not linger past the last dressing.", "plate": ""},
		{"id": "stave", "title": "Stave Bend", "body": "A bend town where the cooper's yard never stops being worked, though no hand sets the hoop now. People live by the yard and keep their barrels honest — a slack hoop here is a debt, and the bend collects its debts in kind. Crews pass through, hoop up, and do not linger past the last tightening.", "plate": ""},
		{"id": "reed", "title": "Reed End", "body": "An end town where the long thatch never stops being laid, though no hand lifts the reed now. People live by the thatch and keep their roofs honest — a thin thatch here is a debt, and the end collects its debts in kind. Crews pass through, thatch up, and do not linger past the last course.", "plate": ""},
		{"id": "peg", "title": "Peg Green", "body": "A green town where the joiner's shop never stops being worked, though no hand fits the joint now. People live by the shop and keep their joints honest — a parted joint here is a debt, and the green collects its debts in kind. Crews pass through, join up, and do not linger past the last fitting.", "plate": ""},
		{"id": "morvain", "title": "Morvain Hollow", "body": "A hollow town where the sunken choir never stops being sung, though no voice lifts the note now. People live by the choir and keep their songs honest — a broken note here is a debt, and the hollow collects its debts in kind. Crews pass through, sing low, and do not linger past the last echo.", "plate": ""},
		{"id": "sylth", "title": "Sylth Veil", "body": "A veil town where the silent veil never stops hanging, though no hand draws it shut now. People live by the veil and keep their crossings honest — a lifted veil here is a debt, and the veil collects its debts in kind. Crews pass through, walk soft, and do not linger past the last fold.", "plate": ""},
		{"id": "drelm", "title": "Drelm Reach", "body": "A reach town where the withering maze never stops growing, though no hand tends the thorn now. People live by the maze and keep their paths honest — a cut thorn here is a debt, and the reach collects its debts in kind. Crews pass through, step careful, and do not linger past the last turn.", "plate": ""},
		{"id": "varneth", "title": "Varneth Deep", "body": "A deep town where the tide pools never stop pulling, though no hand stirs the water now. People live by the pools and keep their tides honest — a stilled tide here is a debt, and the deep collects its debts in kind. Crews pass through, wade careful, and do not linger past the last pull.", "plate": ""},
		{"id": "ostrel", "title": "Ostrel Keep", "body": "A keep town where the outer ward never stops standing, though no hand sets the ward now. People live by the ward and keep their walls honest — a broken ward here is a debt, and the keep collects its debts in kind. Crews pass through, stand straight, and do not linger past the last watch.", "plate": ""},
		{"id": "kethra", "title": "Kethra Grove", "body": "A grove town where the root cellar never stops growing, though no hand tends the root now. People live by the cellar and keep their roots honest — a pulled root here is a debt, and the grove collects its debts in kind. Crews pass through, step soft, and do not linger past the last tendril.", "plate": ""},
		{"id": "ildra", "title": "Ildra Vale", "body": "A vale town where the sieve halls never stop sifting, though no hand works the mesh now. People live by the halls and keep their sieves honest — a clogged mesh here is a debt, and the vale collects its debts in kind. Crews pass through, shake clean, and do not linger past the last screen.", "plate": ""},
		{"id": "vornis", "title": "Vornis Strand", "body": "A strand town where the gleaning fields never stop being gleaned, though no hand gathers now. People live by the fields and keep their baskets honest — a filled basket here is a debt, and the strand collects its debts in kind. Crews pass through, gather light, and do not linger past the last row.", "plate": ""},
		{"id": "tevan", "title": "Tevan Rise", "body": "A rise town where the carved halls never stop being carved, though no hand holds the chisel now. People live by the halls and keep their cuts honest — a dulled edge here is a debt, and the rise collects its debts in kind. Crews pass through, cut clean, and do not linger past the last line.", "plate": ""},
		{"id": "tarnis", "title": "Tarnis March", "body": "A march town where the striding halls never stop being walked, though no foot treads the road now. People live by the halls and keep their strides honest — a shortened stride here is a debt, and the march collects its debts in kind. Crews pass through, walk steady, and do not linger past the last mile.", "plate": ""},
		{"id": "iskarn", "title": "Iskarn Hold", "body": "A hold town where the gilded vaults never stop being gilt, though no hand lays the leaf now. People live by the vaults and keep their gilt honest — a tarnished leaf here is a debt, and the hold collects its debts in kind. Crews pass through, handle light, and do not linger past the last leaf.", "plate": ""},
		{"id": "belran", "title": "Belran Edge", "body": "An edge town where the honing halls never stop being honed, though no hand holds the stone now. People live by the halls and keep their edges honest — a dulled edge here is a debt, and the edge collects its debts in kind. Crews pass through, hone clean, and do not linger past the last pass.", "plate": ""},
		{"id": "cadrin", "title": "Cadrin Reach", "body": "A reach town where the sowing fields never stop being sown, though no hand casts the seed now. People live by the fields and keep their sowing honest — an unsown row here is a debt, and the reach collects its debts in kind. Crews pass through, sow clean, and do not linger past the last row.", "plate": ""},
		{"id": "halden", "title": "Halden Bluff", "body": "A bluff town where the bargain halls never stop being struck, though no hand shakes on the deal now. People live by the halls and keep their bargains honest — a broken deal here is a debt, and the bluff collects its debts in kind. Crews pass through, deal fair, and do not linger past the last word.", "plate": ""},
		{"id": "dunmere", "title": "Dunmere Hollow", "body": "A hollow town where the tending halls never stop being tended, though no hand binds the wound now. People live by the halls and keep their tending honest — an untended hurt here is a debt, and the hollow collects its debts in kind. Crews pass through, tend clean, and do not linger past the last binding.", "plate": ""},
		{"id": "kestrel", "title": "Kestrel Roost", "body": "A roost town where the cleaving halls never stop being cut, though no hand swings the blade now. People live by the halls and keep their cleaving honest — an uncut edge here is a debt, and the roost collects its debts in kind. Crews pass through, cut clean, and do not linger past the last edge.", "plate": ""},
		{"id": "eldren", "title": "Eldren Moor", "body": "A moor town where the piercing halls never stop being pierced, though no hand drives the point now. People live by the halls and keep their piercing honest — an unpierced mark here is a debt, and the moor collects its debts in kind. Crews pass through, pierce clean, and do not linger past the last mark.", "plate": ""},
		{"id": "bracken", "title": "Bracken Weald", "body": "A weald town where the gathering fields never stop being gathered, though no hand lifts the sheaf now. People live by the fields and keep their gathering honest — an ungathered row here is a debt, and the weald collects its debts in kind. Crews pass through, gather clean, and do not linger past the last row.", "plate": ""},
		{"id": "sorath", "title": "Sorath Fell", "body": "A fell town where the hewing halls never stop being hewn, though no hand lifts the axe now. People live by the halls and keep their hewing honest — an unhewn log here is a debt, and the fell collects its debts in kind. Crews pass through, hew clean, and do not linger past the last log.", "plate": ""},
		{"id": "kelvar", "title": "Kelvar Mark", "body": "A mark town where the gauging halls never stop being gauged, though no hand reads the gauge now. People live by the halls and keep their gauging honest — an ungauged measure here is a debt, and the mark collects its debts in kind. Crews pass through, gauge clean, and do not linger past the last measure.", "plate": ""},
		{"id": "vessia", "title": "Vessia Shore", "body": "A shore town where the salvaging fields never stop being salvaged, though no hand hauls the wreck now. People live by the fields and keep their salvaging honest — an unsalvaged wreck here is a debt, and the shore collects its debts in kind. Crews pass through, salvage clean, and do not linger past the last wreck.", "plate": ""},
		{"id": "korvath", "title": "Korvath Trove", "body": "A trove town where the hoarding halls never stop being filled, though no hand fills them now. People live by the halls and keep their hoarding honest — an uncounted coin here is a debt, and the trove collects its debts in kind. Crews pass through, count clean, and do not linger past the last coin.", "plate": ""},
		{"id": "osbrand", "title": "Osbrand Forge", "body": "A forge town where the smelting halls never stop being smelted, though no hand works the bellows now. People live by the halls and keep their smelting honest — an unsmelted ingot here is a debt, and the forge collects its debts in kind. Crews pass through, smelt clean, and do not linger past the last ingot.", "plate": ""},
		{"id": "renvar", "title": "Renvar Spring", "body": "A spring town where the renewing fields never stop being renewed, though no hand draws the water now. People live by the fields and keep their renewing honest — an undrawn bucket here is a debt, and the spring collects its debts in kind. Crews pass through, draw clean, and do not linger past the last bucket.", "plate": ""},
		{"id": "tarnach", "title": "Tarnach Stone", "body": "A stone town where the assaying halls never stop being tested, though no hand rubs the stone now. People live by the halls and keep their assaying honest — an untested sample here is a debt, and the stone collects its debts in kind. Crews pass through, test clean, and do not linger past the last sample.", "plate": ""},
		{"id": "arvane", "title": "Arvane Landing", "body": "A landing town where the ferrying reaches never stop being crossed, though no hand poles the ferry now. People live by the reaches and keep their ferrying honest — an unpaid fare here is a debt, and the river collects its debts in kind. Crews pass through, cross clean, and do not linger past the last crossing.", "plate": ""},
		{"id": "mavren", "title": "Mavren Works", "body": "A works town where the salting pans never stop being cured, though no hand spreads the salt now. People live by the pans and keep their salting honest — an uncured catch here is a debt, and the salt collects its debts in kind. Crews pass through, cure clean, and do not linger past the last pan.", "plate": ""},
		{"id": "velmar", "title": "Velmar Haven", "body": "A haven town where the anchoring roads never stop being held, though no hand drops the anchor now. People live by the roads and keep their anchoring honest — an unheld ship here is a debt, and the tide collects its debts in kind. Crews pass through, hold fast, and do not linger past the last mooring.", "plate": ""},
		{"id": "dessan", "title": "Dessan Ossuary", "body": "An ossuary town where the bonesetting crypt never stops being set, though no hand sets the bones now. People live by the crypt and keep their bonesetting honest — an unset bone here is a debt, and the bone collects its debts in kind. Crews pass through, set clean, and do not linger past the last setting.", "plate": ""},
		{"id": "ondrel", "title": "Ondrel Smithy", "body": "A smithy town where the shoeing yards never stop being shod, though no hand drives the nails now. People live by the yards and keep their shoeing honest — an unshod horse here is a debt, and the road collects its debts in kind. Crews pass through, shoe clean, and do not linger past the last shoeing.", "plate": ""},
		{"id": "esker", "title": "Esker Stand", "body": "A stand town where the felling groves never stop being cut, though no hand swings the axe now. People live by the groves and keep their felling honest — an unfelled tree here is a debt, and the timber collects its debts in kind. Crews pass through, cut clean, and do not linger past the last felling.", "plate": ""},
		{"id": "torvik", "title": "Torvik Heights", "body": "A heights town where the winnowing floor never stops being tossed, though no hand throws the grain now. People live by the floor and keep their winnowing honest — an unmingled heap here is a debt, and the chaff collects its debts in kind. Crews pass through, toss clean, and do not linger past the last winnowing.", "plate": ""},
		{"id": "vinter", "title": "Vinter Wells", "body": "A wells town where the dowsing grounds never stop being walked, though no hand holds the rod now. People live by the grounds and keep their dowsing honest — an unfound spring here is a debt, and the deep collects its debts in kind. Crews pass through, dowse clean, and do not linger past the last dowsing.", "plate": ""},
		{"id": "law_kessock", "title": "Kessock's Chart Law", "body": "What is charted in the Map Rooms stays charted; no road there is ever lost, no coast ever misdrawn. The rooms keep their own charting, and the charting keeps the rooms.", "plate": ""},
		{"id": "law_stow", "title": "Stow's Prop Law", "body": "What is propped in the halls stays propped; no prop there ever slips, no roof ever sags. The halls keep their own shoring, and the shoring keeps the halls.", "plate": ""},
		{"id": "law_calmwater", "title": "Calmwater's Still Law", "body": "What is stilled in the rooms stays stilled; no sound there ever carries, no summons ever answers quick. The rooms keep their own stillness, and the stillness keeps the rooms.", "plate": ""},
		{"id": "law_harrow", "title": "Harrow's Loft Law", "body": "What is fletched in the Lofts stays fletched; no arrow there ever flies crooked, no flight ever loosens. The lofts keep their own aim, and the aim keeps the lofts.", "plate": ""},
		{"id": "law_vigil", "title": "Vigil's Beacon Law", "body": "What is lit in the Vaults stays lit; no lamp there ever dims, no wick ever gutters. The vaults keep their own light, and the light keeps the vaults.", "plate": ""},
		{"id": "law_fallow", "title": "Fallow's Chase Law", "body": "What is snared in the Chase stays snared; no snare there ever springs empty, no trail ever goes cold. The chase keeps its own sets, and the sets keep the chase.", "plate": ""},
		{"id": "law_madder", "title": "Madder's Vat Law", "body": "What is dyed in the Vats stays dyed; no colour there ever runs, no cloth ever fades. The vats keep their own dyeing, and the dyeing keeps the vats.", "plate": ""},
		{"id": "law_barley", "title": "Barley's Floor Law", "body": "What is threshed on the Floor stays threshed; no sheaf there ever thins, no grain ever scatters. The floor keeps its own threshing, and the threshing keeps the floor.", "plate": ""},
		{"id": "law_tanbark", "title": "Tanbark's Pit Law", "body": "What is tanned in the Pits stays tanned; no hide there ever cracks, no leather ever stiffens. The pits keep their own tanning, and the tanning keeps the pits.", "plate": ""},
		{"id": "law_stave", "title": "Stave's Hoop Law", "body": "What is hooped in the Yard stays hooped; no hoop there ever slackens, no barrel ever staves. The yard keeps its own coopering, and the coopering keeps the yard.", "plate": ""},
		{"id": "law_reed", "title": "Reed's Thatch Law", "body": "What is thatched on the Thatch stays thatched; no reed there ever thins, no roof ever leaks. The thatch keeps its own thatching, and the thatching keeps the thatch.", "plate": ""},
		{"id": "law_peg", "title": "Peg's Joint Law", "body": "What is joined in the Shop stays joined; no joint there ever parts, no frame ever racks. The shop keeps its own joining, and the joining keeps the shop.", "plate": ""},
		{"id": "law_morvain", "title": "Morvain's Echo Law", "body": "What is sung in the Choir stays sung; no echo there ever fades, no note ever dies. The choir keeps its own echoing, and the echoing keeps the choir.", "plate": ""},
		{"id": "law_sylth", "title": "Sylth's Veil Law", "body": "What is veiled in the Veil stays veiled; no fold there ever lifts, no crossing ever shows. The veil keeps its own veiling, and the veiling keeps the veil.", "plate": ""},
		{"id": "law_drelm", "title": "Drelm's Thorn Law", "body": "What is thorned in the Maze stays thorned; no thorn there ever withers, no path ever clears. The maze keeps its own withering, and the withering keeps the maze.", "plate": ""},
		{"id": "law_varneth", "title": "Varneth's Tide Law", "body": "What is pulled by the tide stays pulled; no tide there ever stills, no shore ever holds. The pools keep their own tiding, and the tiding keeps the pools.", "plate": ""},
		{"id": "law_ostrel", "title": "Ostrel's Ward Law", "body": "What is warded in the Ward stays warded; no ward there ever breaks, no wall ever falls. The keep keeps its own warding, and the warding keeps the keep.", "plate": ""},
		{"id": "law_kethra", "title": "Kethra's Root Law", "body": "What is rooted in the Cellar stays rooted; no root there ever pulls free, no earth ever loosens. The grove keeps its own rooting, and the rooting keeps the grove.", "plate": ""},
		{"id": "law_ildra", "title": "Ildra's Sieve Law", "body": "What is sifted in the Halls stays sifted; no sieve there ever clogs, no mesh ever blinds. The vale keeps its own sifting, and the sifting keeps the vale.", "plate": ""},
		{"id": "law_vornis", "title": "Vornis's Glean Law", "body": "What is gleaned in the Fields stays gleaned; no basket there ever fills, no field ever empties. The strand keeps its own gleaning, and the gleaning keeps the strand.", "plate": ""},
		{"id": "law_tevan", "title": "Tevan's Chisel Law", "body": "What is carved in the Halls stays carved; no chisel there ever dulls, no line ever fades. The rise keeps its own carving, and the carving keeps the rise.", "plate": ""},
		{"id": "law_tarnis", "title": "Tarnis's Stride Law", "body": "What is walked in the Halls stays walked; no stride there ever shortens, no road ever ends. The halls keep their own striding, and the striding keeps the halls.", "plate": ""},
		{"id": "law_iskarn", "title": "Iskarn's Gilt Law", "body": "What is gilt in the Vaults stays gilt; no leaf there ever tarnishes, no gold ever dulls. The vaults keep their own gilding, and the gilding keeps the vaults.", "plate": ""},
		{"id": "law_belran", "title": "Belran's Hone Law", "body": "What is honed in the Halls stays honed; no whetstone there ever wears thin, no edge there ever loses its keenness. The halls keep their own honing, and the honing keeps the halls.", "plate": ""},
		{"id": "law_cadrin", "title": "Cadrin's Sowing Law", "body": "What is sown in the Fields stays sown; no seed there ever fails, no furrow ever lies fallow. The fields keep their own sowing, and the sowing keeps the fields.", "plate": ""},
		{"id": "law_halden", "title": "Halden's Bargain Law", "body": "What is struck in the Halls stays struck; no bargain there ever breaks, no deal ever sours. The halls keep their own bargaining, and the bargaining keeps the halls.", "plate": ""},
		{"id": "law_dunmere", "title": "Dunmere's Tending Law", "body": "What is tended in the Halls stays tended; no bandage there ever frays, no wound there ever festers. The halls keep their own tending, and the tending keeps the halls.", "plate": ""},
		{"id": "law_kestrel", "title": "Kestrel's Cleaving Law", "body": "What is cut in the Halls stays cut; no edge there ever dulls, no blade ever turns. The halls keep their own cleaving, and the cleaving keeps the halls.", "plate": ""},
		{"id": "law_eldren", "title": "Eldren's Piercing Law", "body": "What is pierced in the Halls stays pierced; no point there ever breaks, no seam ever closes. The halls keep their own piercing, and the piercing keeps the halls.", "plate": ""},
		{"id": "law_bracken", "title": "Bracken's Gathering Law", "body": "What is gathered in the Fields stays gathered; no sheaf there ever rots, no row ever lies ungathered. The fields keep their own gathering, and the gathering keeps the fields.", "plate": ""},
		{"id": "law_sorath", "title": "Sorath's Hewing Law", "body": "What is hewn in the Halls stays hewn; no axe there ever chips, no log ever lies whole. The halls keep their own hewing, and the hewing keeps the halls.", "plate": ""},
		{"id": "law_kelvar", "title": "Kelvar's Gauging Law", "body": "What is gauged in the Halls stays gauged; no gauge there ever fails, no measure ever comes back wrong. The halls keep their own gauging, and the gauging keeps the halls.", "plate": ""},
		{"id": "law_vessia", "title": "Vessia's Salvaging Law", "body": "What is salvaged in the Fields stays salvaged; no wreck there ever loses its cargo, no tide ever takes the haul back. The fields keep their own salvaging, and the salvaging keeps the fields.", "plate": ""},
		{"id": "law_korvath", "title": "Korvath's Hoarding Law", "body": "What is hoarded in the Halls stays hoarded; no purse there ever empties, no coin ever goes uncounted. The halls keep their own hoarding, and the hoarding keeps the halls.", "plate": ""},
		{"id": "law_osbrand", "title": "Osbrand's Smelting Law", "body": "What is smelted in the Halls stays smelted; no forge there ever cools, no ingot ever comes back raw. The halls keep their own smelting, and the smelting keeps the halls.", "plate": ""},
		{"id": "law_renvar", "title": "Renvar's Renewing Law", "body": "What is renewed in the Fields stays renewed; no spring there ever runs dry, no draught ever comes back spent. The fields keep their own renewing, and the renewing keeps the fields.", "plate": ""},
		{"id": "law_tarnach", "title": "Tarnach's Assaying Law", "body": "What is assayed in the Halls stays assayed; no stone there ever lies, no sample ever comes back unknown. The halls keep their own assaying, and the assaying keeps the halls.", "plate": ""},
		{"id": "law_arvane", "title": "Arvane's Ferrying Law", "body": "What is ferried in the Reaches stays ferried; no ferry there ever stops crossing, no fare ever comes back unpaid. The reaches keep their own ferrying, and the ferrying keeps the reaches.", "plate": ""},
		{"id": "law_mavren", "title": "Mavren's Salting Law", "body": "What is salted in the Pans stays salted; no salt there ever loses its keeping, no catch ever comes back spoiled. The pans keep their own salting, and the salting keeps the pans.", "plate": ""},
		{"id": "law_velmar", "title": "Velmar's Anchoring Law", "body": "What is anchored in the Roads stays anchored; no anchor there ever drags, no mooring ever comes back loose. The roads keep their own anchoring, and the anchoring keeps the roads.", "plate": ""},
		{"id": "law_dessan", "title": "Dessan's Bonesetting Law", "body": "What is set in the Crypt stays set; no bone there ever breaks, no limb ever comes back crooked. The crypt keeps its own bonesetting, and the bonesetting keeps the crypt.", "plate": ""},
		{"id": "law_ondrel", "title": "Ondrel's Shoeing Law", "body": "What is shod in the Yards stays shod; no shoe there ever throws, no horse ever comes back lame. The yards keep their own shoeing, and the shoeing keeps the yards.", "plate": ""},
		{"id": "law_esker", "title": "Esker's Felling Law", "body": "What is felled in the Groves stays felled; no trunk there ever stands back up, no stump ever comes back whole. The groves keep their own felling, and the felling keeps the groves.", "plate": ""},
		{"id": "law_torvik", "title": "Torvik's Winnowing Law", "body": "What is winnowed on the Floor stays winnowed; no grain there ever mixes back, no heap ever comes back chaffed. The floor keeps its own winnowing, and the winnowing keeps the floor.", "plate": ""},
		{"id": "law_vinter", "title": "Vinter's Dowsing Law", "body": "What is dowsed in the Grounds stays found; no spring there ever hides again, no rod ever comes back level. The grounds keep their own dowsing, and the dowsing keeps the grounds.", "plate": ""},
		{"id": "law_ferren", "title": "Ferren's Edge Law", "body": "What is sharpened at the edge stays sharpened; no edge honed there ever dulls again. The halls keep their own keenness, and the keenness keeps the halls.", "plate": ""},
		{"id": "law_aeran", "title": "Aeran's Gale Law", "body": "What the gale takes in weight, the gale keeps; no step down the stair is ever as heavy as the step back up. The stair keeps its own wind, and the wind keeps the stair.", "plate": ""},
		{"id": "law_tabor", "title": "Tabor's Beat Law", "body": "What is beaten in the deep stays beaten; no rhythm struck there is ever lost, no beat ever dropped. The deep keeps its own time, and the time keeps the deep.", "plate": ""},
		{"id": "law_cindrel", "title": "Cindrel's Kiln Law", "body": "What is fired in the pits stays fired; no pot there ever cracks, no iron there ever cools. The pits keep their own heat, and the heat keeps the pits.", "plate": ""},
		{"id": "law_veyne", "title": "Veyne's Loom Law", "body": "What is woven in the rooms stays woven; no thread there ever frays, no knot there ever slips. The rooms keep their own weave, and the weave keeps the rooms.", "plate": ""},
		{"id": "law_halveth", "title": "Halveth's Knot Law", "body": "What is knotted in the yards stays knotted; no rope there ever slips, no knot there ever comes undone. The yards keep their own knots, and the knots keep the yards.", "plate": ""},
		{"id": "law_riven", "title": "Riven's Market Law", "body": "What is traded in the market stays traded; no bargain struck there is ever undone. The market keeps its own accounts, and the accounts always balance.", "plate": ""},
		{"id": "law_quill", "title": "Quill's Script Law", "body": "What is written in the Stacks stays written; no page there is ever blanked, no line ever struck through.", "plate": ""},
		{"id": "law_umbra", "title": "Umbra's Shadow Law", "body": "In the Long Shadow, every light casts two shadows, and only the first belongs to the light. The second belongs to the shadow, and the shadow keeps what is its.", "plate": ""},
		{"id": "law_durn", "title": "Durn's Steps Law", "body": "Delvers going down at Durn say the steps keep their own count: what descends is counted on the way down, and counted again on the way back — and the counts never match. Nothing is lost on the steps, and nothing is given. That is the steps' own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_sarn", "title": "Sarn's Gallery Law", "body": "Delvers in the Long Gallery say what hangs there stays hung: nothing falls, nothing is taken down, and nothing is added without the gallery's say-so. Crews walk the gallery and touch nothing. That is the gallery's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_brask", "title": "Brask's Orchard Law", "body": "Delvers in the Iron Orchard say what grows there is pruned, and what is pruned stays pruned — the orchard keeps its own shape, and the shape is the law. Crews walk the rows and cut nothing. That is the orchard's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_nerith", "title": "Nerith's Span Law", "body": "Delvers crossing to Nerith say the span keeps its own count: what crosses pays its weight, and the weight is never argued. Nothing is lost on the span, and nothing is given. That is the span's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_voss", "title": "Voss's Pane Law", "body": "Delvers in the Warrens say every shard belongs to a pane, and every pane is whole — break one and the Warrens notice, the way a body notices a cut. Crews walk the glass paths and touch nothing. That is the Warrens' own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_keld", "title": "Keld's Quiet Law", "body": "Delvers going down into Keld say the Deep keeps its own silence: what makes noise there is heard, and what is heard is answered. Crews go down quiet and come back quiet. That is the Deep's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_karath", "title": "Karath's Seam Law", "body": "Delvers on Karath say the place runs in its seams: gold lines in the rock where one law of the place shows through. A wedge of tunnel gold, set in a seam and driven home, breaks that one law. The seam mends itself in time. That is Karath's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_thalor", "title": "Thalor's Deep Law", "body": "Delvers going down into Thalor say the Halls keep what goes down: what you carry below stays below until you carry it back up yourself. Nothing in the Halls is lost, and nothing in the Halls is given. That is the Halls' own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_mirell", "title": "Mirell's Still Water Law", "body": "Delvers in the Vault say the water there never rises and never drains — it sits at the same mark it sat at when the Vault's maker left, whatever the weather above. Crews wade it, work around it, and do not test it. That is the Vault's own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
		{"id": "law_ossara", "title": "Ossara's Row Law", "body": "Delvers in the Barrows say what is laid in a row stays in its row: stones, steps, and the dead themselves, each in its place and none wandering. Walk the rows and the rows hold you. Step off them and you are on your own. That is the Barrows' own habit, and delvers do not claim it holds anywhere else.", "plate": ""},
	]},
	{"name": "COALESCENCES", "entries": [
		{"id": "wedges", "title": "The Wedge", "body": "A forearm of tunnel gold, blunted where the hammer has struck it again and again. Tunnel gold is the metal of a dead creation's law-seams — and a wedge forged from it is a maker's power, coalesced: one dead maker's own way of making, solidified into a thing you can hold. Set it in a gold seam, drive it home with one blow, and one law of that dead place breaks. The breaks crack the wedge, and a cracked wedge weighs on the hand that carries it. The songs give the most legendary delvers more than one.", "plate": ""},
		{"id": "casket", "title": "The Sealed Casket", "body": "A palm of lead, seamless — no lid, no line, no way in that any eye can find. It came out of the deep seam of the Hollow Making, where a foreign maker's power had been left running. Delvers who have held it say the same thing in different words: whatever it rests against, closes. Perfectly. Without seam. And stays closed. That is the part they agree on. The rest — where it came from, what it was sealing — they only whisper about.", "plate": ""},
		{"id": "keptstone", "title": "The Kept Stone", "body": "A stone, smooth as a river rock, warm when you hold it. Delvers who have carried one say it remembers the way back — not the road, the feeling of having walked it. Nobody writes down how that works. Nobody needs to: the stone does what it does, and the hand that holds it does the rest.", "plate": ""},
		{"id": "truecube", "title": "The True Cube", "body": "A cube of pale metal, every edge the same length, every corner square. Set it down and the room feels finished. Delvers say a place with the cube in it stops arguing with itself. What it argues about when the cube is gone, they don't say.", "plate": ""},
		{"id": "everseed", "title": "The Ever Seed", "body": "A seed, green against dead metal, that never stops growing — not fast, not all at once, just always. Delvers plant stories about it and harvest nothing. It grows whether anyone watches or not. That is the whole of it, and it is enough.", "plate": ""},
		{"id": "deepbell", "title": "The Deep Bell", "body": "A small iron bell, heavy for its size, that never tarnishes no matter how deep it goes. It does not ring on its own. Held, it steadies the hand — the crew stands a little straighter with it in the pack, and blows that should have landed hard land softer. Why, nobody says. The bell keeps its own counsel.", "plate": ""},
		{"id": "levelbeads", "title": "The Level Beads", "body": "Two small wooden beads on a thread, that always hang level with each other no matter how the thread is held. Crews that carry them fall into step faster — the work of staying together comes easier, like the beads were already doing it. Nobody explains it. The beads do not need explaining.", "plate": ""},
		{"id": "evenscales", "title": "The Even Scales", "body": "A pair of small brass scales that always balance, whatever is set on them — a feather against a stone, and the beam does not move. Crews that carry them say nothing is lost on the road: what the crew earns, the crew keeps, weighed true. How, nobody says. The scales do not need explaining.", "plate": ""},
		{"id": "seamneedle", "title": "The Seam Needle", "body": "A needle of clear glass, thin as a hair, that sews torn things whole — cloth, skin, and once, the story goes, a cut in a law itself. Crews that carry it mend faster; a stim goes further in the hand, like the needle was already doing half the work. Nobody explains it. The needle does not need explaining.", "plate": ""},
		{"id": "listeninghorn", "title": "The Listening Horn", "body": "A hollow horn, light as a shell, that always hears the way back — blow it in the dark and the sound comes back from the road you came in by, even when the road is gone. Crews that carry it strike truer, like they hear where the blow should land before they throw it. Nobody explains it. The horn does not need explaining.", "plate": ""},
		{"id": "dredgehook", "title": "The Dredge Hook", "body": "An iron hook, heavy and plain, that always finds what sank — drop it in any water and it comes up holding something that was lost. Crews that carry it say nothing stays lost on the road: what the crew earns from a fight, the crew keeps a little more of. How, nobody says. The hook does not need explaining.", "plate": ""},
		{"id": "hunglantern", "title": "The Hung Lantern", "body": "A lantern that hangs in the air where no hook is, burning without oil and without going out. Crews that carry it strike truer — the light falls on the seam before the blow lands, like the lantern was already showing it. Nobody explains it. The lantern does not need explaining.", "plate": ""},
		{"id": "ironshears", "title": "The Iron Shears", "body": "Shears of black iron, heavy in the hand, that cut only what should be cut — cloth, cord, and once, the story goes, a bad night's sleep. Crews that carry them rest cleaner: a rest by the ember goes further, like the shears had already trimmed the worst of the day away. Nobody explains it. The shears do not need explaining.", "plate": ""},
		{"id": "returnedcoin", "title": "The Returned Coin", "body": "A coin that always finds its way back to the purse that paid it — spent, traded, dropped down a well, it turns up again in the same purse by morning. Crews that carry it say the wilds pay a little better with it along: what falls to the crew, the crew keeps more of. How, nobody says. The coin does not need explaining.", "plate": ""},
		{"id": "unblottedquill", "title": "The Unblotted Quill", "body": "A quill that never runs dry and never blots, however fast the hand moves. Crews that carry it walk a little quicker — the next step seems written before the foot lands, like the road were already drafted under them. Nobody explains it. The quill does not need explaining.", "plate": ""},
		{"id": "secondshadow", "title": "The Second Shadow", "body": "A shadow that falls where no light is cast — it keeps to the walker's heel and slips where the walker slips. Crews that carry it dodge a little farther, like the shadow were already showing the way out. Nobody explains it. The shadow does not need explaining.", "plate": ""},
		{"id": "everedge", "title": "The Ever Edge", "body": "A blade's edge, bright as a new whet, that never dulls however much it cuts — stone, iron, or a closed form, the edge comes out the same. Crews that carry it strike at the seam a little truer: the hard blows land harder, like the edge were already showing where to cut. How, nobody says. The edge does not need explaining.", "plate": ""},
		{"id": "unspentbreath", "title": "The Unspent Breath", "body": "A breath, held and kept, that never runs out — spent, and still there, ready to be spent again. Crews that carry it recover their footing quicker after a dodge, like the breath were already back in their lungs before they landed. Nobody explains it. The breath does not need explaining.", "plate": ""},
		{"id": "steadydrum", "title": "The Steady Drum", "body": "A small drum that beats its own rhythm and never falters, never tires, never drops a beat. Crews that carry it fall into the rhythm and strike quicker — the next blow seems to come on the beat, like the drum were already keeping time for the hand. How, nobody says. The drum does not need explaining.", "plate": ""},
		{"id": "undyingcoal", "title": "The Undying Coal", "body": "A coal that burns without fuel and never cools, however long it sits — black, hot, and patient in the hand. Crews that carry it say their skills come out fired hotter, like the coal were already burning in the blow. How, nobody says. The coal does not need explaining.", "plate": ""},
		{"id": "unbrokenthread", "title": "The Unbroken Thread", "body": "A thread that never breaks and never tangles, however hard it is pulled — fine, plain, and patient in the hand. Crews that carry it say the crew holds together harder, like the thread were already binding them. Nobody explains it. The thread does not need explaining.", "plate": ""},
		{"id": "holdingknot", "title": "The Holding Knot", "body": "A knot that never slips and never unties, however it is pulled — tight, plain, and patient in the hand. Crews that carry it say the between charges less for a held course, like the knot were already holding the ship's line true. Nobody explains it. The knot does not need explaining.", "plate": ""},
		{"id": "millstone", "title": "The Unworn Millstone", "body": "A millstone, round and grey, that never wears however much it grinds — grain, stone, or a closed form, the stone comes out the same. Crews that carry it say their breaking blows land harder, like the stone were already grinding at the seam. How, nobody says. The stone does not need explaining.", "plate": ""},
		{"id": "cornerstone", "title": "The Cornerstone", "body": "A cornerstone, square and plain, that never shifts however the wall leans — set it in a wall and the wall holds. Crews that carry it stand a little harder under blows, like the stone were already holding the line for them. Nobody explains it. The stone does not need explaining.", "plate": ""},
		{"id": "bucket", "title": "The Unfailing Bucket", "body": "A bucket, plain wood and iron, that always comes up full however deep the well — lowered empty, raised brimming. Crews that carry it mend a little on every kill, like the bucket were already drawing something back up. How, nobody says. The bucket does not need explaining.", "plate": ""},
		{"id": "cask", "title": "The Unemptied Cask", "body": "A cask, stout wood and iron, that never empties however much is drawn — tapped at dawn, still pouring at dusk. Crews that carry it say their flasks mend deeper, like the cask were already pouring into the wound. How, nobody says. The cask does not need explaining.", "plate": ""},
		{"id": "vein", "title": "The Unfailing Vein", "body": "A vein of ore, dark and bright, that never plays out however much is taken — cut it back and it stands full again. Crews that carry it say the wedge's cracks weigh less on the road, like the vein were already holding the way steady. Nobody explains it. The vein does not need explaining.", "plate": ""},
		{"id": "sprig", "title": "The Unwilting Sprig", "body": "A sprig, green and sharp-smelling, that never wilts however long it is carried — cut at dawn, still fresh weeks on. Crews that carry it say their mending goes further, like the sprig were already doing half the work. How, nobody says. The sprig does not need explaining.", "plate": ""},
		{"id": "chart", "title": "The Unfading Chart", "body": "A chart, ink on vellum, whose lines never fade however far it is carried — drawn at dawn, still sharp weeks on. Crews that carry it say the between opens a little wider, like the chart were already showing one more leg of road. How, no hand says. The chart does not need explaining.", "plate": ""},
		{"id": "prop", "title": "The Unyielding Prop", "body": "A prop, stout timber and iron, that never gives however much weight leans on it — set under a roof, and the roof stays. Crews that carry it say the great blows land softer, like the prop were already standing between them and the fall. How, no hand says. The prop does not need explaining.", "plate": ""},
		{"id": "flute", "title": "The Silent Flute", "body": "A flute, plain wood, that sounds nothing however hard it is blown — put to the lips, and the room goes quiet instead. Crews that carry it say what would answer answers slower, like the silence were already holding the summons back. How, no hand says. The flute does not need explaining.", "plate": ""},
		{"id": "arrow", "title": "The Unerring Arrow", "body": "An arrow, straight ash and grey flight, that never flies crooked however bent the bow — loosed in the dark, still true at the mark. Crews that carry it say their blows find the seam more often, like the arrow were already showing where to cut. How, no hand says. The arrow does not need explaining.", "plate": ""},
		{"id": "lamp", "title": "The Unwaning Lamp", "body": "A lamp, plain iron and clear glass, that never dims however long the night runs — lit at dusk, still bright at dawn. Crews that carry it say the fallen come back stronger, like the lamp were already holding them short of the dark. How, no hand says. The lamp does not need explaining.", "plate": ""},
		{"id": "snare", "title": "The Patient Snare", "body": "A snare, cord and bent sapling, that never springs wrong however long it waits — set at dusk, still set at dawn. Crews that carry it say their blows land harder, like the snare were already closed around the mark. How, no hand says. The snare does not need explaining.", "plate": ""},
		{"id": "dye", "title": "The Everfast Dye", "body": "A dye, madder red in the jar, that never runs however hard the rain falls — cloth dipped at dawn, still fast weeks on. Crews that carry it say their blows find the seam more often, like the dye were already marking where to cut. How, no hand says. The dye does not need explaining.", "plate": ""},
		{"id": "sheaf", "title": "The Unthinned Sheaf", "body": "A sheaf, bound barley straw, that never thins however hard it is threshed — beaten at dawn, still full at dusk. Crews that carry it say their blows land harder, like the sheaf were already standing behind the swing. How, no hand says. The sheaf does not need explaining.", "plate": ""},
		{"id": "hide", "title": "The Uncracked Hide", "body": "A hide, tanned bark-brown, that never cracks however hard it is worked — stretched at dawn, still whole at dusk. Crews that carry it say the blows land softer, like the hide were already standing between them and the fall. How, no hand says. The hide does not need explaining.", "plate": ""},
		{"id": "hoop", "title": "The Ever-Tight Hoop", "body": "A hoop, iron-dark in the hand, that never slackens however the barrel swells — bound at dawn, still tight weeks on. Crews that carry it say the outfitters charge them less, like the hoop were already keeping the bargain shut. How, no hand says. The hoop does not need explaining.", "plate": ""},
		{"id": "thatch", "title": "The Unleaking Thatch", "body": "A thatch, reed-pale in the hand, that never thins however many winters pass over it — laid at dawn, still thick years on. Crews that carry it say the songs they lift hold longer, like the thatch were already keeping the weather off the note. How, no hand says. The thatch does not need explaining.", "plate": ""},
		{"id": "joint", "title": "The Unparting Joint", "body": "A joint, oak-pegged in the hand, that never parts however hard it is pulled — fitted at dawn, still true weeks on. Crews that carry it say what falls nearby comes to hand easier, like the joint were already pulling the scattered pieces together. How, no hand says. The joint does not need explaining.", "plate": ""},
		{"id": "undyingecho", "title": "The Undying Echo", "body": "An echo, clear in the hand, that never fades however far it travels — sung at dawn, still sounding weeks on. Crews that carry it say their blows land from farther off, like the echo were already carrying the strike ahead of the hand. How, no hand says. The echo does not need explaining.", "plate": ""},
		{"id": "unliftingveil", "title": "The Unlifting Veil", "body": "A veil, grey in the hand, that never lifts however hard the wind pulls — drawn at dawn, still shut weeks on. Crews that carry it say their tonics steady the flesh as well as the nerve, like the veil were already holding the wound shut. How, no hand says. The veil does not need explaining.", "plate": ""},
		{"id": "unwitheringthorn", "title": "The Unwithering Thorn", "body": "A thorn, dark in the hand, that never withers however long the drought holds — cut at dawn, still green weeks on. Crews that carry it say rest finds them one tonic richer, like the thorn were already keeping something back for the road. How, no hand says. The thorn does not need explaining.", "plate": ""},
		{"id": "unstilledtide", "title": "The Unstilled Tide", "body": "A tide, cold in the hand, that never stills however the shore holds — pulled at dawn, still running weeks on. Crews that carry it say their skills come back quicker, like the tide were already pulling the spent strength home. How, no hand says. The tide does not need explaining.", "plate": ""},
		{"id": "unbrokenward", "title": "The Unbroken Ward", "body": "A ward, iron in the hand, that never breaks however hard the blow falls — set at dawn, still standing weeks on. Crews that carry it say their guard holds a little better, like the ward were already standing between them and the fall. How, no hand says. The ward does not need explaining.", "plate": ""},
		{"id": "unpulledroot", "title": "The Unpulled Root", "body": "A root, dark in the hand, that never pulls free however hard the ground shakes — cut at dawn, still holding weeks on. Crews that carry it say rest finds them one flask richer, like the root were already keeping something back for the road. How, no hand says. The root does not need explaining.", "plate": ""},
		{"id": "uncloggedsieve", "title": "The Unclogged Sieve", "body": "A sieve, bright in the hand, that never clogs however much passes through it — shaken at dawn, still clear weeks on. Crews that carry it say their strikes land a tenth harder, like the sieve were already shaking something loose for the blow. How, no hand says. The sieve does not need explaining.", "plate": ""},
		{"id": "unfilledpouch", "title": "The Unfilled Pouch", "body": "A pouch, light in the hand, that never fills however much is gathered into it — filled at dawn, still empty weeks on. Crews that carry it say the fallen yield a tenth more, like the pouch were already gathering something extra from the kill. How, no hand says. The pouch does not need explaining.", "plate": ""},
		{"id": "undulledchisel", "title": "The Undulled Chisel", "body": "A chisel, keen in the hand, that never dulls however much it carves — cut at dawn, still keen weeks on. Crews that carry it say their blows bite true a touch oftener, like the chisel were already cutting toward the weak place. How, no hand says. The chisel does not need explaining.", "plate": ""},
		{"id": "untiredstride", "title": "The Untired Stride", "body": "A stride, light in the step, that never tires however far the road runs — walked at dawn, still fresh weeks on. Crews that carry it say their step comes quicker, like the stride were already covering the road ahead. How, no hand says. The stride does not need explaining.", "plate": ""},
		{"id": "untarnishedgilt", "title": "The Untarnished Gilt", "body": "A gilt, bright in the hand, that never tarnishes however much it passes hand to hand — laid at dawn, still bright weeks on. Crews that carry it say what they gather runs a tenth richer, like the gilt were already gilding the take. How, no hand says. The gilt does not need explaining.", "plate": ""},
		{"id": "unwornwhetstone", "title": "The Unworn Whetstone", "body": "A whetstone, grey in the hand, that never wears however much it hones — cut at dawn, still true weeks on. Crews that carry it say their skills bite a tenth harder, like the stone were already honing the blow. How, no hand says. The whetstone does not need explaining.", "plate": ""},
		{"id": "unemptiedsack", "title": "The Unemptied Sack", "body": "A sack, worn in the hand, that never empties however much is sown — filled at dawn, still full weeks on. Crews that carry it say what they learn runs a tenth richer, like the sack were already sowing the gain. How, no hand says. The sack does not need explaining.", "plate": ""},
		{"id": "unbrokenbargain", "title": "The Unbroken Bargain", "body": "A bargain, struck in the hand, that never breaks however hard the haggling — made at dawn, still standing weeks on. Crews that carry it say their fares run a tenth cheaper, like the bargain were already cutting the price. How, no hand says. The bargain does not need explaining.", "plate": ""},
		{"id": "unfrayedbandage", "title": "The Unfrayed Bandage", "body": "A bandage, clean in the hand, that never frays however much it binds — wrapped at dawn, still true weeks on. Crews that carry it say their stims mend a tenth deeper, like the bandage were already closing the hurt. How, no hand says. The bandage does not need explaining.", "plate": ""},
		{"id": "unbluntedcleaver", "title": "The Unblunted Cleaver", "body": "A cleaver, heavy in the hand, that never blunts however much it cleaves — honed at dawn, still keen weeks on. Crews that carry it say their strikes land a tenth harder, like the cleaver were already cutting the blow. How, no hand says. The cleaver does not need explaining.", "plate": ""},
		{"id": "unbrokenpoint", "title": "The Unbroken Point", "body": "A point, sharp in the hand, that never breaks however much it pierces — ground at dawn, still true weeks on. Crews that carry it say their blows find the seam a little more often, like the point were already showing the way in. How, no hand says. The point does not need explaining.", "plate": ""},
		{"id": "unrottedharvest", "title": "The Unrotted Harvest", "body": "A harvest, full in the hand, that never rots however long it waits — reaped at dawn, still fresh weeks on. Crews that carry it say the fallen yield a tenth more, like the harvest were already gathering something extra from the kill. How, no hand says. The harvest does not need explaining.", "plate": ""},
		{"id": "unchippedaxe", "title": "The Unchipped Axe", "body": "An axe, heavy in the hand, that never chips however much it hews — swung at dawn, still sound weeks on. Crews that carry it say their strikes land a tenth harder, like the axe were already biting before the blow. How, no hand says. The axe does not need explaining.", "plate": ""},
		{"id": "unfailinggauge", "title": "The Unfailing Gauge", "body": "A gauge, true in the hand, that never fails however much it measures — read at dawn, still exact weeks on. Crews that carry it say their blows find the seam a little more often, like the gauge were already showing the measure of the thing. How, no hand says. The gauge does not need explaining.", "plate": ""},
		{"id": "unlostwreck", "title": "The Unlost Wreck", "body": "A wreck, laden in the hand, that never loses what it carried however deep it sank — hauled at dawn, still laden weeks on. Crews that carry it say the fallen yield a tenth more, like the wreck were already giving up something held back from the deep. How, no hand says. The wreck does not need explaining.", "plate": ""},
		{"id": "unemptyingpurse", "title": "The Unemptying Purse", "body": "A purse, heavy in the hand, that never empties however much is drawn from it — opened at dawn, still heavy weeks on. Crews that carry it say their takings run a tenth richer, like the purse were already holding something back for the road. How, no hand says. The purse does not need explaining.", "plate": ""},
		{"id": "unquenchedforge", "title": "The Unquenched Forge", "body": "A forge, no bigger than a brazier, that never cools however long it stands untended — lit at dawn, still burning weeks on. Crews that carry it say their skills land a tenth harder, like the heat were already in the blow before it fell. How, no hand says. The forge does not need explaining.", "plate": ""},
		{"id": "undryingspring", "title": "The Undrying Spring", "body": "A spring, cold where it rises, that never runs dry however much is drawn from it — drawn at dawn, still rising weeks on. Crews that carry it say their skills come back a tenth quicker, like the spring were already refilling what was spent. How, no hand says. The spring does not need explaining.", "plate": ""},
		{"id": "unlyingstone", "title": "The Unlying Stone", "body": "A touchstone, dark and smooth, that never lies however much is rubbed on it — rubbed at dawn, still true weeks on. Crews that carry it say their lessons run a tenth richer, like the stone had already weighed what the road meant to teach. How, no hand says. The stone does not need explaining.", "plate": ""},
		{"id": "unceasingferry", "title": "The Unceasing Ferry", "body": "A ferry, low and patient, that never stops crossing however wide the water grows — pushed off at dawn, still crossing weeks on. Crews that carry it say their fares run a tenth cheaper, like the ferry were already mid-river before the toll was asked. How, no hand says. The ferry does not need explaining.", "plate": ""},
		{"id": "keepingsalt", "title": "The Keeping Salt", "body": "A salt, white as ash, that keeps whatever it touches from going bad — laid on at dawn, still keeping weeks on. Crews that carry it say their stims mend a tenth deeper, like the salt had already kept the wound from worsening. How, no hand says. The salt does not need explaining.", "plate": ""},
		{"id": "undragginganchor", "title": "The Undragging Anchor", "body": "An anchor, black with old brine, that never drags however hard the tide pulls — dropped at dawn, still holding weeks on. Crews that carry it say their guard holds a tenth truer, like the anchor had already taken the strain before the blow landed. How, no hand says. The anchor does not need explaining.", "plate": ""},
		{"id": "unbrokenbone", "title": "The Unbroken Bone", "body": "A bone, pale and dense, that never breaks however hard the blow that lands on it — struck at dawn, still whole weeks on. Crews that carry it say their flesh stands a tenth harder, like the bone had already been set before the breaking was tried. How, no hand says. The bone does not need explaining.", "plate": ""},
		{"id": "unthrownshoe", "title": "The Unthrown Shoe", "body": "A shoe, bright at the rim, that is never thrown however hard the road is run — nailed on at dawn, still fast weeks on. Crews that carry it say their steps come a tenth quicker, like the shoe were already on the road ahead of the foot. How, no hand says. The shoe does not need explaining.", "plate": ""},
		{"id": "unswervingaxe", "title": "The Unswerving Axe", "body": "An axe, bright at the edge, that never turns or glances in the stroke however hard the wood fights back — swung at dawn, still biting true weeks on. Crews that carry it say their blows land a tenth harder, like the stroke had already found the grain before the swing came down. How, no hand says. The axe does not need explaining.", "plate": ""},
		{"id": "unmingledgrain", "title": "The Unmingled Grain", "body": "A grain, clean and golden, that never mingles back with its chaff however long it lies heaped — tossed at dawn, still true weeks on. Crews that carry it say their blows find the seam a little more often, like the chaff had already blown off the stroke before it landed. How, no hand says. The grain does not need explaining.", "plate": ""},
		{"id": "seekingrod", "title": "The Seeking Rod", "body": "A forked rod, green-hearted and restless, that never lies level while anything is hidden under the ground however deep it is buried — cut at dawn, still dipping weeks on. Crews that carry it say more of what falls stays in their hands, like the rod had already pointed at the keeping of it. How, no hand says. The rod does not need explaining.", "plate": ""},
		{"id": "straightrow", "title": "The Straight Row", "body": "A short row of pale stones, laid straight, that stays straight however the ground slopes under it. Set it down on a hillside and the row does not follow the hill. Crews that carry it find their own steps falling into order — skills come back a little quicker, like the row was already keeping time. Where it came from, the whispers only say the Barrows, and rows.", "plate": ""},
	]},
	{"name": "KEEPERS", "entries": [
		{"id": "warden", "title": "The Warden", "body": "Every great making has one servant set above the rest — the keeper of the maker's last law. The Warden of the Hollow Making was still executing its orders when your crew arrived: seal the deep room, keep them out, let nothing change. It was not evil. It was unfinished obedience, the size of a house.", "plate": "res://assets/codex_plates/warden.jpg"},
		{"id": "sealed", "title": "The Sealed", "body": "It was not a warden. It was what a changed place grows when something foreign rests in it too long: a law that learned to stand up and keep the door itself. It did not speak. It sealed. That was the whole of its argument, and it was almost enough.", "plate": ""},
		{"id": "uncut_door", "title": "The Uncut Door", "body": "It was not a keeper. It was a door the changed place grew where no door had been cut, standing in a wall nobody had built. It did not guard a room. It was the room's refusal, standing up. The crew broke it the way you break any closed form: at the seam, all at once, and the wall behind it was only wall again.", "plate": ""},
		{"id": "deep_sentinel", "title": "The Deep Sentinel", "body": "The last watch of the Deeping Halls, still at its post long after the halls emptied. It kept the deep rooms the way it was told to: shut, dark, and nobody passing. It was not cruel. It was finished work, still being done, by something that never got told to stop.", "plate": ""},
		{"id": "tallyman", "title": "The Tallyman", "body": "The counter of the Sunken Vault, standing where the water never quite reaches. It kept the vault the way vaults are kept: closed, counted, and nothing taken that was not tallied. The crew broke it the way you break any closed form: at the seam, all at once, and the vault stayed open behind them.", "plate": ""},
		{"id": "row_walker", "title": "The Row-Walker", "body": "It walks the Hollow Barrows the way the rows were laid down: straight, quiet, one step after another, and nobody stepping off the line. It did not chase. It did not need to. The barrows were its ground, and it knew every step of them.", "plate": ""},
		{"id": "weighmaster", "title": "The Weighmaster", "body": "The keeper of the Hanging Vaults, still at its post counting what crosses the span. It weighed every load that ever crossed, and it weighs crews the same way now: not cruel, just exact. The span keeps what it is owed, and the Weighmaster keeps the count.", "plate": ""},
		{"id": "glazier", "title": "The Glazier", "body": "The keeper of the Glass Warrens, fitting every shard back into its pane. It does not chase. It does not need to. The warrens are glass, and glass cuts whatever runs through it uninvited. The Glazier only walks behind, and puts the pieces back.", "plate": ""},
		{"id": "listener", "title": "The Listener", "body": "The keeper of the Quiet Deep, sitting in the silence and listening. It does not roar. It does not need to. Crews that go down quiet come back quiet. Crews that go down loud — the Deep hears them first, and the Listener hears them second.", "plate": ""},
		{"id": "undertow", "title": "The Undertow", "body": "The keeper of the Sunken Steps, still standing where the water takes the stairs. It does not chase. It does not need to. The steps go down, and what goes down stays down — that is the whole of its argument, and the water agrees with it.", "plate": ""},
		{"id": "curator", "title": "The Curator", "body": "The keeper of the Long Gallery, still hanging what the maker left on the walls. It does not guard the gallery. It tends it: straightening frames, dusting glass, and standing where the light falls best. Crews that touch the hangings learn the difference between tending and guarding the hard way.", "plate": ""},
		{"id": "pruner", "title": "The Pruner", "body": "The keeper of the Iron Orchard, still cutting what grows wrong. The orchard is iron, and iron does not grow — except here, where it does, slow as rust. The Pruner cuts the wrong growth and leaves the right. Crews are growth, as far as it is concerned. It cuts accordingly.", "plate": ""},
		{"id": "tollkeeper", "title": "The Tollkeeper", "body": "The keeper of the Shuttered Exchange, still taking its toll at the market gate. It does not haggle and it does not hurry. Everything that passes pays, one way or another — that is the whole of its argument, and the market agrees with it.", "plate": ""},
		{"id": "binder", "title": "The Binder", "body": "The keeper of the Ink Stacks, still binding what the maker left written. It does not guard the stacks. It keeps them: straightening pages, mending spines, and standing where the ink dries slowest. Crews that tear pages learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "silhouette", "title": "The Silhouette", "body": "The keeper of the Long Shadow, still standing where the light ends. It does not chase. It does not need to. The shadow is long, and what walks into it walks out thinner — that is the whole of its argument, and the dark agrees with it.", "plate": ""},
		{"id": "whetstone", "title": "The Whetstone", "body": "The keeper of the Whet Halls, still sharpening what the maker left edged. It does not guard the halls. It keeps them keen: turning the stones, testing the edges, and standing where the sparks fall thickest. Crews that walk in dull learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "gale", "title": "The Gale", "body": "The keeper of the Wind Stair, still blowing where the stair goes down. It does not chase. It does not need to. The stair is wind, and what walks down it walks against the wind the whole way — that is the whole of its argument, and the stair agrees with it.", "plate": ""},
		{"id": "drummer", "title": "The Drummer", "body": "The keeper of the Drum Deep, still beating the rhythm the maker left. It does not guard the deep. It keeps the beat: steady, patient, and never once out of time. Crews that break the rhythm learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "kilnmaster", "title": "The Kilnmaster", "body": "The keeper of the Firing Pits, still firing what the maker left in the kilns. It does not guard the pits. It keeps them hot: stoking the coals, turning the pots, and standing where the heat falls thickest. Crews that walk in cold learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "weaver", "title": "The Weaver", "body": "The keeper of the Warp Rooms, still weaving what the maker left on the looms. It does not guard the rooms. It keeps them threaded: straightening warp, mending weft, and standing where the light falls best. Crews that tangle the thread learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "knotter", "title": "The Knotter", "body": "The keeper of the Knotted Yards, still knotting what the maker left tied. It does not guard the yards. It keeps them fast: checking lines, tightening knots, and standing where the rope runs thickest. Crews that slip a knot learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "miller", "title": "The Miller", "body": "The keeper of the Grinding Halls, still grinding what the maker left in the mill. It does not guard the halls. It keeps them turning: feeding the stones, sweeping the meal, and standing where the dust falls thickest. Crews that walk in unground learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "mason", "title": "The Mason", "body": "The keeper of the Long Wall, still laying what the maker left unlaid. It does not guard the wall. It keeps it true: setting stones, pointing mortar, and standing where the wall runs highest. Crews that lean on the wall learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "wellkeeper", "title": "The Wellkeeper", "body": "The keeper of the Deep Well, still drawing what the maker left below. It does not guard the well. It keeps it full: lowering the bucket, raising it brimming, and standing where the water runs deepest. Crews that drink without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "brewer", "title": "The Brewer", "body": "The keeper of the Mash Tuns, still brewing what the maker left in the tuns. It does not guard the tuns. It keeps them working: stirring the mash, tapping the casks, and standing where the steam falls thickest. Crews that drink without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "miner", "title": "The Miner", "body": "The keeper of the Deep Cuttings, still cutting what the maker left in the rock. It does not guard the cuttings. It keeps them giving: swinging the pick, shoring the roof, and standing where the vein runs richest. Crews that dig without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "herbalist", "title": "The Herbalist", "body": "The keeper of the Walled Garden, still gathering what the maker left growing. It does not guard the garden. It keeps it green: cutting sprigs, bundling herbs, and standing where the growth runs thickest. Crews that pick without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "cartographer", "title": "The Cartographer", "body": "The keeper of the Map Rooms, still charting what the maker left drawn. It does not guard the rooms. It keeps them charted: inking the coasts, sounding the roads, and standing where the lines run truest. Crews that chart without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "shorer", "title": "The Shorer", "body": "The keeper of the Propped Halls, still shoring what the maker left standing. It does not guard the halls. It keeps them standing: setting props, wedging timbers, and standing where the weight leans hardest. Crews that build without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "stillman", "title": "The Stillman", "body": "The keeper of the Silent Rooms, still quieting what the maker left hushed. It does not guard the rooms. It keeps them still: closing doors, muffling steps, and standing where the quiet runs deepest. Crews that speak without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "fletcher", "title": "The Fletcher", "body": "The keeper of the Fletching Lofts, still fletching what the maker left feathered. It does not guard the lofts. It keeps them fletched: fitting flights, truing shafts, and standing where the aim runs truest. Crews that aim without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "lamplighter", "title": "The Lamplighter", "body": "The keeper of the Lamp Vaults, still lighting what the maker left burning. It does not guard the vaults. It keeps them lit: trimming wicks, feeding oil, and standing where the light runs steadiest. Crews that burn without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "hunter", "title": "The Hunter", "body": "The keeper of the Deep Chase, still hunting what the maker left tracked. It does not guard the chase. It keeps it hunted: setting snares, reading trails, and standing where the game runs thickest. Crews that hunt without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "dyer", "title": "The Dyer", "body": "The keeper of the Dye Vats, still dyeing what the maker left coloured. It does not guard the vats. It keeps them dyed: stirring vats, setting colours, and standing where the dye runs deepest. Crews that dye without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "thresher", "title": "The Thresher", "body": "The keeper of the Threshing Floor, still threshing what the maker left bound. It does not guard the floor. It keeps it threshed: swinging flails, winnowing chaff, and standing where the grain runs thickest. Crews that thresh without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "tanner", "title": "The Tanner", "body": "The keeper of the Tanning Pits, still tanning what the maker left stretched. It does not guard the pits. It keeps them tanned: turning hides, working bark, and standing where the pits run deepest. Crews that tan without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "cooper", "title": "The Cooper", "body": "The keeper of the Cooper's Yard, still coopering what the maker left hooped. It does not guard the yard. It keeps it hooped: setting staves, driving hoops, and standing where the barrels run tightest. Crews that hoop without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "thatcher", "title": "The Thatcher", "body": "The keeper of the Long Thatch, still thatching what the maker left roofed. It does not guard the thatch. It keeps it thatched: laying reed, dressing courses, and standing where the roof runs thickest. Crews that thatch without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "joiner", "title": "The Joiner", "body": "The keeper of the Joiner's Shop, still joining what the maker left fitted. It does not guard the shop. It keeps it joined: cutting joints, pegging frames, and standing where the work runs truest. Crews that join without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "choirmaster", "title": "The Choirmaster", "body": "The keeper of the Sunken Choir, still singing what the maker left echoed. It does not guard the choir. It keeps it sung: holding notes, turning echoes, and standing where the song runs deepest. Crews that sing without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "shroud", "title": "The Shroud", "body": "The keeper of the Silent Veil, still veiling what the maker left shut. It does not guard the veil. It keeps it shut: drawing folds, stilling crossings, and standing where the veil runs thickest. Crews that lift without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "blight", "title": "The Blight", "body": "The keeper of the Withering Maze, still withering what the maker left thorned. It does not guard the maze. It keeps it withered: growing thorns, closing paths, and standing where the maze runs tightest. Crews that cut without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "ebb", "title": "The Ebb", "body": "The keeper of the Tide Pools, still tiding what the maker left pulled. It does not guard the pools. It keeps them pulled: drawing tides, turning currents, and standing where the pull runs strongest. Crews that still without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "bastion", "title": "The Bastion", "body": "The keeper of the Outer Ward, still warding what the maker left standing. It does not guard the ward. It keeps it standing: setting wards, holding walls, and standing where the ward runs thickest. Crews that break without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "taproot", "title": "The Taproot", "body": "The keeper of the Root Cellar, still rooting what the maker left grown. It does not guard the cellar. It keeps it grown: driving roots, closing earth, and standing where the root runs deepest. Crews that pull without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "sieve", "title": "The Sieve", "body": "The keeper of the Sieve Halls, still sifting what the maker left unsifted. It does not guard the halls. It keeps them sifted: shaking mesh, clearing screens, and standing where the sifting runs finest. Crews that clog without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "gleaner", "title": "The Gleaner", "body": "The keeper of the Gleaning Fields, still gleaning what the maker left ungleaned. It does not guard the fields. It keeps them gleaned: walking rows, lifting what fell, and standing where the gleaning runs thinnest. Crews that fill without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "carver", "title": "The Carver", "body": "The keeper of the Carved Halls, still carving what the maker left uncarved. It does not guard the halls. It keeps them carved: cutting lines, clearing chips, and standing where the carving runs deepest. Crews that dull without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "strider", "title": "The Strider", "body": "The keeper of the Striding Halls, still striding what the maker left walked. It does not guard the halls. It keeps them walked: pacing roads, marking miles, and standing where the stride runs longest. Crews that shorten without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "gilder", "title": "The Gilder", "body": "The keeper of the Gilded Vaults, still gilding what the maker left gilt. It does not guard the vaults. It keeps them gilt: laying leaf, burnishing gold, and standing where the gilt runs brightest. Crews that tarnish without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "honer", "title": "The Honer", "body": "The keeper of the Honing Halls, still honing what the maker left edged. It does not guard the halls. It keeps them edged: working stones, truing blades, and standing where the edge runs keenest. Crews that dull without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "sower", "title": "The Sower", "body": "The keeper of the Sowing Fields, still sowing what the maker left seeded. It does not guard the fields. It keeps them sown: casting seed, tending rows, and standing where the furrow runs deepest. Crews that reap without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "haggler", "title": "The Haggler", "body": "The keeper of the Bargain Halls, still striking what the maker left agreed. It does not guard the halls. It keeps them struck: weighing offers, sealing deals, and standing where the bargain runs hardest. Crews that break faith without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "tender", "title": "The Tender", "body": "The keeper of the Tending Halls, still tending what the maker left bound. It does not guard the halls. It keeps them tended: wrapping hurts, changing dressings, and standing where the wound runs deepest. Crews that bleed without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "cleaver", "title": "The Cleaver", "body": "The keeper of the Cleaving Halls, still cleaving what the maker left cut. It does not guard the halls. It keeps them cut: swinging the blade, trimming edges, and standing where the cut runs deepest. Crews that cut without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "piercer", "title": "The Piercer", "body": "The keeper of the Piercing Halls, still piercing what the maker left marked. It does not guard the halls. It keeps them pierced: driving points, marking seams, and standing where the mark runs truest. Crews that pierce without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "gatherer", "title": "The Gatherer", "body": "The keeper of the Gathering Fields, still gathering what the maker left grown. It does not guard the fields. It keeps them gathered: lifting sheaves, binding rows, and standing where the growth runs thickest. Crews that gather without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "hewer", "title": "The Hewer", "body": "The keeper of the Hewing Halls, still hewing what the maker left grown. It does not guard the halls. It keeps them hewn: swinging axes, splitting logs, and standing where the timber runs thickest. Crews that hew without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "gauger", "title": "The Gauger", "body": "The keeper of the Gauging Halls, still gauging what the maker left unmeasured. It does not guard the halls. It keeps them gauged: reading gauges, taking measures, and standing where the measure runs truest. Crews that gauge without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "salvager", "title": "The Salvager", "body": "The keeper of the Salvaging Fields, still salvaging what the maker left sunk. It does not guard the fields. It keeps them salvaged: hauling wrecks, sorting cargo, and standing where the wreckage runs deepest. Crews that salvage without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "hoarder", "title": "The Hoarder", "body": "The keeper of the Hoarding Halls, still hoarding what the maker left scattered. It does not guard the halls. It keeps them counted: weighing purses, stacking coin, and standing where the trove runs deepest. Crews that take without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "smelter", "title": "The Smelter", "body": "The keeper of the Smelting Halls, still smelting what the maker left raw. It does not guard the halls. It keeps them hot: working bellows, pouring ingots, and standing where the forge-fire runs brightest. Crews that smelt without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "renewer", "title": "The Renewer", "body": "The keeper of the Renewing Fields, still renewing what the maker left spent. It does not guard the fields. It keeps them flowing: drawing water, filling cups, and standing where the spring runs coldest. Crews that draw without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "assayer", "title": "The Assayer", "body": "The keeper of the Assaying Halls, still testing what the maker left unproven. It does not guard the halls. It keeps them honest: rubbing samples, reading streaks, and standing where the stone runs truest. Crews that haul without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "ferryman", "title": "The Ferryman", "body": "The keeper of the Ferrying Reaches, still crossing what the maker left unferried. It does not guard the reaches. It keeps them crossed: poling the ferry, taking tolls, and standing where the current runs deepest. Crews that cross without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "salter", "title": "The Salter", "body": "The keeper of the Salting Pans, still curing what the maker left raw. It does not guard the pans. It keeps them salted: spreading salt, turning catches, and standing where the brine runs whitest. Crews that cure without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "anchorite", "title": "The Anchorite", "body": "The keeper of the Anchoring Roads, still holding what the maker left unanchored. It does not guard the roads. It keeps them held: dropping anchors, paying out chain, and standing where the tide runs hardest. Crews that moor without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "bonesetter", "title": "The Bonesetter", "body": "The keeper of the Bonesetting Crypt, still setting what the maker left broken. It does not guard the crypt. It keeps them set: straightening bones, binding splints, and standing where the bone runs whitest. Crews that break without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "farrier", "title": "The Farrier", "body": "The keeper of the Shoeing Yards, still shoeing what the maker left barefoot. It does not guard the yards. It keeps them shod: driving nails, rasping hooves, and standing where the road runs hardest. Crews that run without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "axeman", "title": "The Axeman", "body": "The keeper of the Felling Groves, still felling what the maker left standing. It does not guard the groves. It keeps them felled: swinging axes, wedging trunks, and standing where the timber runs thickest. Crews that cut without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "winnower", "title": "The Winnower", "body": "The keeper of the Winnowing Floor, still winnowing what the maker left mixed. It does not guard the floor. It keeps it winnowed: tossing grain, fanning chaff, and standing where the wind runs strongest. Crews that mix without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "dowser", "title": "The Dowser", "body": "The keeper of the Dowsing Grounds, still dowsing what the maker left hidden. It does not guard the grounds. It keeps them dowsed: walking rods, reading dips, and standing where the ground runs deepest. Crews that dig without leave learn the difference between keeping and guarding the hard way.", "plate": ""},
		{"id": "last_captain", "title": "The Last Captain", "body": "The Bereft's last captain, still captaining after the fleet is gone. Crews that have faced it say it fights like a salvage run: everything stripped, nothing wasted, every move paying for itself. It does not lead from behind. It leads from the front, because there is no behind left.", "plate": "res://assets/codex_plates/last_captain.jpg"},
		{"id": "maw", "title": "The Maw", "body": "What the Tithe tithes to, when it walks. Crews do not describe it the same way twice, and the ones who describe it at all are the ones who got away. The only part that repeats: it does not chase. It waits where the road narrows, and the road narrows everywhere, sooner or later.", "plate": "res://assets/codex_plates/maw.jpg"},
		{"id": "axis", "title": "The Axis", "body": "The Pattern's center, if a pattern can be said to have one. Crews that have seen it say the machines around it stop solving and start agreeing — every line pointing the same way, every answer the same answer. It does not argue. It aligns. That is worse, in the moment, than any argument.", "plate": "res://assets/codex_plates/axis.jpg"},
		{"id": "imperator", "title": "The Imperator", "body": "The Iron Host's law, standing up. Crews say it does not fight like a soldier — it fights like a siege: slow, certain, and already counted. The Host's counts always balance, and the Imperator is the hand that holds the tally. When it moves, the whole Host moves with it.", "plate": "res://assets/codex_plates/imperator.jpg"},
		{"id": "first_claimed", "title": "The First Claimed", "body": "A delver captain, claimed long ago — the first of them, or so the whispers say. It still walks the between roads the way it walked them as a captain, only now the road walks with it. Crews that meet it say the worst part is not the fight. It is the recognition: it remembers being a delver, and it wants company.", "plate": "res://assets/codex_plates/first_claimed.jpg"},
		{"id": "first_unburied", "title": "The First Unburied", "body": "The first of the risen dead, still rising. Crews say it does not lead the Unburied the way a captain leads — it leads the way a grave leads: by being the deepest thing in the ground, and everything else settling toward it. It has been dead longer than any of them, and it is angrier than all of them.", "plate": "res://assets/codex_plates/first_unburied.jpg"},
	]},
	{"name": "FACTIONS", "entries": [
		{"id": "faction_bereft", "title": "The Bereft", "body": "Crews that meet them on the between roads say the same thing in different words: a people with no creation left, stripping dead places bare with ships and tools patched from other people's wrecks. They do not hate delvers. Delvers carry the richest salvage on the road, and the Bereft take what is carried. That is the whole of the argument, as far as anyone walking away from it can tell.", "plate": "res://assets/codex_plates/faction_bereft.jpg"},
		{"id": "faction_tithe", "title": "The Tithe", "body": "Delvers whisper about this one the way they whisper about weather that has already turned. The Tithe came out of the old killing, and it keeps killing — not for ground, not for plunder, but as a tithe, paid upward to something the crews never see. A delver crew on the road is not an enemy to them. It is an offering, walking.", "plate": "res://assets/codex_plates/faction_tithe.jpg"},
		{"id": "faction_pattern", "title": "The Pattern", "body": "Cold machines, moving in lines that make sense only to themselves. Crews that have watched them say they are not cruel and not kind — they solve. A dead creation is a problem with an answer, and the answer is pattern. Delvers in the way are not hated. They are remainders. The Pattern resolves remainders.", "plate": "res://assets/codex_plates/faction_pattern.jpg"},
		{"id": "faction_iron", "title": "The Iron Host", "body": "An army that never stopped marching, from a creation that is gone and a war that never ended. Its law is conquest: ground taken is ground kept, and everything carried is either territory or a weapon. Delver ships are territory. Delver packs are weapons. The Host does not negotiate either point.", "plate": "res://assets/codex_plates/faction_iron.jpg"},
		{"id": "faction_claimed", "title": "The Claimed", "body": "Delvers who have seen them come back quieter. The Claimed were people once, or something close enough that the difference does not matter — then something in the between took hold of them, and what they were is gone. Only the claim remains, wearing their shape. Crews give them a wide road. The claim spreads to whoever stands in it.", "plate": "res://assets/codex_plates/faction_claimed.jpg"},
		{"id": "faction_unburied", "title": "The Unburied", "body": "The old killing's dead, up and walking, and furious about it. Crews say they do not march like an army — they rise like weather, wherever the ground has been left untended. The living are an offense to them, and a delver crew is fresh bodies walking straight into the argument. Bury your dead deep on the road. Or do not bury them at all.", "plate": "res://assets/codex_plates/faction_unburied.jpg"},
	]},
	{"name": "SHIPS & PARTS", "entries": [
		{"id": "ships", "title": "Ships", "body": "Delvers cross between dead creations in ships — bought, fitted, and flown by crews who know the between. Ember Rest keeps a shipyard now. What hulls it can build, and what they cost, is a conversation for the yard, not this page.", "plate": ""},
	]},
]
